datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// ENUMS
// ==========================================

enum Role {
  ADMIN
  STAFF
  GUEST
}

enum BookingStatus {
  UNCONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
}

// ==========================================
// MODELS
// ==========================================

model Country {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  code      String   // e.g. "pt", "us", "de"
  flagUrl   String   // Flag icon asset URL or path
  users     User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("countries")
}

model Cabin {
  id           String    @id @default(uuid())
  name         String    @unique
  maxCapacity  Int
  regularPrice Float
  discount     Float     @default(0)
  description  String    @db.Text
  coverImage   String    // Main thumbnail / hero photo
  images       String[]  // Gallery photo URLs / R2 keys
  bookings     Booking[]

  // Auditing & Soft Delete
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime? // NULL = active, timestamp = soft deleted

  @@map("cabins")
}

model User {
  id        String    @id @default(uuid())
  clerkId   String    @unique // External Clerk User ID (e.g. user_2bX...)
  email     String    @unique
  fullName  String
  avatar    String?
  role      Role      @default(GUEST)

  // Country reference for flag display
  countryId Int?
  country   Country?  @relation(fields: [countryId], references: [id], onDelete: SetNull)

  bookings  Booking[]

  // Auditing & Soft Delete
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // NULL = active, timestamp = soft deleted

  @@map("users")
}

model Booking {
  id          String        @id @default(uuid())
  startDate   DateTime
  endDate     DateTime
  numNights   Int
  numGuests   Int
  cabinPrice  Float
  totalPrice  Float
  status      BookingStatus @default(UNCONFIRMED)
  isPaid      Boolean       @default(false)

  // Cancellation & Refund tracking
  isCancelled Boolean       @default(false)
  cancelledAt DateTime?
  isRefunded  Boolean       @default(false)

  // Relations
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  cabinId     String
  cabin       Cabin         @relation(fields: [cabinId], references: [id], onDelete: Restrict)

  // Auditing & Soft Delete
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?     // NULL = active, timestamp = soft deleted

  @@map("bookings")
}
