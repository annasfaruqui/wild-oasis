# ==========================================
# Database (Neon Postgres via Vercel)
# ==========================================
# Recommended for most uses (pooled connection for serverless queries):
DATABASE_URL="postgresql://neondb_owner:password@ep-sample-pooler.region.aws.neon.tech/neondb?channel_binding=require&sslmode=require"

# For uses requiring a connection without pgbouncer (direct connection for Prisma migrations):
DATABASE_URL_UNPOOLED="postgresql://neondb_owner:password@ep-sample.region.aws.neon.tech/neondb?sslmode=require"

# Parameters for constructing your own connection string
PGHOST="ep-sample-pooler.region.aws.neon.tech"
PGHOST_UNPOOLED="ep-sample.region.aws.neon.tech"
PGUSER="neondb_owner"
PGDATABASE="neondb"
PGPASSWORD="password"

# Parameters for Vercel Postgres Templates
POSTGRES_URL="postgresql://neondb_owner:password@ep-sample-pooler.region.aws.neon.tech/neondb?channel_binding=require&sslmode=require"
POSTGRES_URL_NON_POOLING="postgresql://neondb_owner:password@ep-sample.region.aws.neon.tech/neondb?channel_binding=require&sslmode=require"
POSTGRES_USER="neondb_owner"
POSTGRES_HOST="ep-sample-pooler.region.aws.neon.tech"
POSTGRES_PASSWORD="password"
POSTGRES_DATABASE="neondb"
POSTGRES_URL_NO_SSL="postgresql://neondb_owner:password@ep-sample-pooler.region.aws.neon.tech/neondb"
POSTGRES_PRISMA_URL="postgresql://neondb_owner:password@ep-sample-pooler.region.aws.neon.tech/neondb?channel_binding=require&connect_timeout=15&sslmode=require"

# ==========================================
# Authentication (Clerk)
# ==========================================
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_samplekey123456789"
CLERK_SECRET_KEY="sk_test_samplekey123456789"

NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/cabins"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/cabins"
